# Copy this file to .env.local (untracked) and fill in real values from
# your Supabase project: Project Settings -> API.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security and is used only
# in server-only code (see src/lib/supabase/server.ts) -- never expose it
# to the browser or commit it. There is no anon/public key in use: the
# app has no client-side Supabase access, only server actions and server
# components using the service role.

SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# From the Stripe Dashboard (test mode to start): Developers -> API keys
# for the secret key, Developers -> Webhooks for the signing secret once
# the endpoint below is registered. Both are server-only (see
# src/lib/stripe/server.ts) -- never exposed to the browser.
STRIPE_SECRET_KEY=sk_test_your-secret-key
# Register https://<your-domain>/api/stripe/webhook in the Stripe
# Dashboard, subscribed to checkout.session.completed, then paste the
# signing secret it gives you here.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# From the Resend dashboard (resend.com): Domains -> add & verify
# littlestargazer.com, then API Keys -> create. Used only to send a
# purchased reading's link back to a parent who lost it -- no marketing
# email, no nurture sequence. RESEND_FROM_EMAIL must be an address on a
# domain verified in that same Resend account, or sends will fail.
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL=Little Stargazers <contact@littlestargazer.com>

# From sentry.io (free tier): create a project (platform: Next.js),
# then Settings -> Client Keys (DSN) for the DSN value. Used for error
# alerting only (chart-generation failures, webhook errors, etc.) --
# nothing else. SENTRY_DSN covers server/edge errors; the same value
# also goes in NEXT_PUBLIC_SENTRY_DSN to catch client-side errors (it's
# meant to be public -- Sentry DSNs are not secret). Leave both unset
# to disable Sentry entirely (see sentry.server.config.ts).
SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/0
# Optional: only needed if you also want Sentry to upload source maps
# at build time (better stack traces in the dashboard). Org/project
# slugs come from your Sentry project URL; the auth token from
# Settings -> Auth Tokens (needs project:releases scope). The build
# works fine without these -- source maps just won't upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# The production domain, used to build absolute URLs in sitemap.xml and
# robots.txt (see src/app/sitemap.ts, src/app/robots.ts). No trailing
# slash. UPDATE THIS once the real production domain is settled -- it
# currently falls back to a placeholder if unset.
NEXT_PUBLIC_SITE_URL=https://littlestargazer.com
